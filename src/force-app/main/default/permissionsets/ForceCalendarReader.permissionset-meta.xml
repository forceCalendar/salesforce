<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <classAccesses>
        <apexClass>ForceCalendarController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <description>Optional Event reader grants for ForceCalendar. Adds controller access, Access Activities, and required readable Event fields. Does not remove write access granted elsewhere. No related-record or broad record access; assignment is manual.</description>
    <!-- Activity Description, WhoId and WhatId FLS is shared with Task. -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Event.Description</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Event.IsAllDayEvent</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Event.Location</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Event.WhatId</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Event.WhoId</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- Explicit Task counterparts preserve shared Activity FLS on redeploy. -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Task.Description</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Task.WhatId</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Task.WhoId</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- Subject, StartDateTime and EndDateTime do not support independent FLS. -->
    <label>ForceCalendar Reader</label>
    <userPermissions>
        <enabled>true</enabled>
        <name>ActivitiesAccess</name>
    </userPermissions>
</PermissionSet>
